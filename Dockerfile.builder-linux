# Linux toolchain image for IdleOT client builds (desktop + deps).
# Rebuild when tools/qt/qt-version.sh (in otclient) changes:
#   docker build -f Dockerfile.builder-linux -t ghcr.io/idleot/client-builder-linux:$(date +%Y%m%d) .
# Qt itself is still installed via install-qt.sh into a cache mount / cached dir
# so this image stays lean; it carries OS deps + ccache + ninja.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      autoconf autoconf-archive automake \
      ca-certificates curl git \
      gcc-14 g++-14 \
      libegl1-mesa-dev libfontconfig1-dev libgl1-mesa-dev libglu1-mesa-dev \
      libltdl-dev libtool libtool-bin \
      libx11-dev libx11-xcb-dev libxcursor-dev libxi-dev libxinerama-dev \
      libxkbcommon-dev libxkbcommon-x11-0 libxrandr-dev \
      linux-libc-dev make ninja-build patchelf perl pkg-config \
      python3 python3-venv ccache \
      gzip brotli \
 && rm -rf /var/lib/apt/lists/*

ENV CC=gcc-14 CXX=g++-14 \
    CCACHE_DIR=/ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CMAKE_C_COMPILER_LAUNCHER=ccache

RUN mkdir -p /ccache && ccache --max-size=4G
WORKDIR /src
